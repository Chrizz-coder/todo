# ============================================
#  Supabase Configuration (copy to .env)
# ============================================

# Your Supabase Project URL
# Find it at: supabase.com → your project → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase "anon" public key
# Find it at: supabase.com → your project → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
